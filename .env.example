# ================================================
# CONFIGURACIÓN DEL AGENTE DE IA PARA SHOPIFY
# ================================================

# Base de datos
DATABASE_URL=postgresql://postgres:password@localhost:5432/shopify_ai_agent
# Para desarrollo local con SQLite:
# DATABASE_URL=sqlite:///./shopify_ai_agent.db

# Configuración de Shopify
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Tokens de acceso específicos por tienda (reemplazar DOMAIN con dominio de la tienda)
# SHOPIFY_TOKEN_TIENDA_EXAMPLE_MYSHOPIFY_COM=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Configuración del servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Configuración de CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Seguridad
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=another-secret-key-for-jwt-tokens
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis (para cache y sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=Shopify AI Agent

# Monitoreo y Analytics
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
ENABLE_SENTRY=false

# Performance Monitoring
ENABLE_PROFILING=false
ENABLE_MEMORY_PROFILING=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Celery (para tareas en background)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Configuración de archivos
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["txt", "csv", "json", "xlsx"]

# Configuración de AI Agent
AI_AGENT_NAME=Shopify Sports AI
AI_AGENT_VERSION=1.0.0
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_CONTEXT_LENGTH=8000

# Configuración de datos deportivos
SPORTS_DATA_UPDATE_INTERVAL=3600  # segundos
SPORTS_DATA_SOURCE=local_files
ENABLE_SPORTS_DATA_SYNC=true

# API Externa para datos deportivos (opcional)
ESPN_API_KEY=your_espn_api_key_here
SPORTS_RADAR_API_KEY=your_sports_radar_api_key_here

# Configuración de análisis predictivo
ENABLE_PREDICTIVE_ANALYTICS=true
PREDICTION_CONFIDENCE_THRESHOLD=0.8
ENABLE_SALES_FORECASTING=true

# Configuración de recomendaciones
MAX_RECOMMENDATIONS_PER_REQUEST=10
RECOMMENDATION_CACHE_TTL=3600  # segundos
ENABLE_COLLABORATIVE_FILTERING=true

# Configuración de webhooks
WEBHOOK_VERIFICATION_ENABLED=true
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=3

# Configuración de backup
ENABLE_AUTO_BACKUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=./backups

# Social Media APIs (para análisis de sentiment)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Configuración de desarrollo
ENABLE_API_DOCS=true
ENABLE_DEBUG_TOOLBAR=true
ENABLE_QUERY_LOGGING=false

# Configuración de testing
TEST_DATABASE_URL=sqlite:///./test_shopify_ai_agent.db
TEST_SHOPIFY_API_KEY=test_api_key
TEST_OPENAI_API_KEY=test_openai_key

# Configuración de producción
ENABLE_HTTPS_REDIRECT=false
TRUSTED_HOSTS=["localhost", "127.0.0.1"]
MAX_REQUEST_SIZE=16777216  # 16MB

# Variables específicas del negocio
BUSINESS_NAME=Your Sports Store
BUSINESS_TIMEZONE=America/New_York
BUSINESS_CURRENCY=USD
BUSINESS_LANGUAGE=es

# Configuración de notificaciones
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Machine Learning y embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_db
ENABLE_SIMILARITY_SEARCH=true

# Configuración de geolocación
ENABLE_LOCATION_BASED_RECOMMENDATIONS=true
DEFAULT_COUNTRY=US
DEFAULT_TIMEZONE=America/New_York

# Configuración de A/B Testing
ENABLE_AB_TESTING=false
AB_TEST_PERCENTAGE=10

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_MOBILE_OPTIMIZATION=true
ENABLE_VOICE_INTERFACE=false

# Configuración de métricas
METRICS_COLLECTION_INTERVAL=300  # 5 minutos
ENABLE_BUSINESS_METRICS=true
ENABLE_TECHNICAL_METRICS=true

# Configuración de internacionalización
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=["es", "en"]
ENABLE_AUTO_TRANSLATION=false

# Configuración de búsqueda
SEARCH_INDEX_UPDATE_INTERVAL=3600
ENABLE_FUZZY_SEARCH=true
SEARCH_RESULTS_LIMIT=50

# Configuración de imágenes
IMAGE_PROCESSING_ENABLED=true
IMAGE_MAX_SIZE=2048
IMAGE_QUALITY=85
SUPPORTED_IMAGE_FORMATS=["jpeg", "png", "webp"]

# Variables de integración específicas
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
FACEBOOK_PIXEL_ID=xxxxxxxxxxxxxxxxxx
HOTJAR_SITE_ID=xxxxxxx

# Configuración de escalabilidad
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
WORKER_PROCESSES=4

# Configuración de compliance
ENABLE_GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
ENABLE_PRIVACY_MODE=false